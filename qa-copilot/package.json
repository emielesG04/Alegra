{
  "name": "qa-copilot",
  "version": "1.0.0",
  "description": "AI-powered QA Copilot for automated test case generation using ISTQB techniques",
  "main": "src/index.js",
  "type": "module",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "demo": "node src/index.js --mode=ai",
    "demo:mock": "node src/index.js --mode=mock",
    "demo:example": "node src/index.js --mode=ai --input=evaluation/cases/case-001-complete.txt",
    "test": "node tests/run-tests.js",
    "evaluate": "node tests/evaluate-ai.js"
  },
  "keywords": [
    "qa",
    "testing",
    "ai",
    "istqb",
    "test-automation",
    "quality-engineering"
  ],
  "author": "Elvis Mieles - QA Lead ACME Corp",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "nanoid": "^6.0.1",
    "openai": "^7.15.0"
  }
}
